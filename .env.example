# Veridit Identity Service — ambiente de DESENVOLVIMENTO
# Copie para .env e troque todos os valores "troque-*". O .env nunca vai para o Git.

APP_NAME="Veridit Identity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco do Identity Service (única conexão da aplicação — ADR-012) ---
DB_CONNECTION=identity
DB_DRIVER=pgsql
DB_HOST=identity-db
DB_PORT=5432
DB_DATABASE=identity
DB_USERNAME=identity_app
DB_PASSWORD=troque-identity

# --- Usados SÓ pelo docker-compose para criar os containers de banco ---
# Superusuário "postgres" de cada container (administração).
POSTGRES_ADMIN_PASSWORD=troque-admin-postgres
# Bancos vazios dos outros serviços (a aplicação NÃO se conecta a eles).
COMMERCE_DB_PASSWORD=troque-commerce
EVIDENCE_DB_PASSWORD=troque-evidence
NOTIFICATION_DB_PASSWORD=troque-notification

# --- Administrador inicial (criado por: php artisan db:seed --class=AdminSeeder) ---
# Senha: mínimo 8 caracteres, com letras e números. CPF: válido (com ou sem máscara).
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@veridit.local
ADMIN_PASSWORD=troque-Admin123
ADMIN_CPF=

# --- JWT (ADR-001) ---
# Gere com: docker compose exec app php artisan jwt:secret  (diferente em dev e prod)
JWT_SECRET=
JWT_TTL=15              # access token: 15 minutos
JWT_REFRESH_TTL=10080   # janela de refresh: 7 dias
JWT_BLACKLIST_ENABLED=true

# --- CORS: origens do front-end (separadas por vírgula) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API stateless (JWT): sem sessão no servidor.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# --- E-mail: Mailpit (http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@veridit.local"
MAIL_FROM_NAME="${APP_NAME}"
