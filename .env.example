# Veridit — orquestração do DESENVOLVIMENTO (docker-compose.yml na raiz).
# Copie para .env (nunca vai para o Git). Só senhas dos 4 bancos (ADR-012: um banco por serviço).
# Cada serviço recebe apenas a SUA senha, no próprio .env:
#   backend/identity/.env  DB_PASSWORD = IDENTITY_DB_PASSWORD
#   backend/commerce/.env  DB_PASSWORD = COMMERCE_DB_PASSWORD

# Superusuário "postgres" de cada container (administração)
POSTGRES_ADMIN_PASSWORD=troque-admin-postgres
IDENTITY_DB_PASSWORD=troque-identity
COMMERCE_DB_PASSWORD=troque-commerce
# Bancos ainda vazios (Evidence e Notification: outras equipes)
EVIDENCE_DB_PASSWORD=troque-evidence
NOTIFICATION_DB_PASSWORD=troque-notification
