# URL base da API do Identity Service (sem barra no final).
# Copie para .env.local se quiser trocar.
#   dev do backend:      http://localhost:8000/api/v1
#   produção local:      http://localhost:8080/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# URL base da API do Commerce Service (pacotes, pedidos, pagamento, saldo)
#   dev do backend:      http://localhost:8001/api/v1
#   produção local:      http://localhost:8081/api/v1
VITE_COMMERCE_API_URL=http://localhost:8001/api/v1
