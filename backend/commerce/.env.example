# Veridit Commerce Service — DESENVOLVIMENTO (copie para commerce/.env)
APP_NAME="Veridit Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Banco PRÓPRIO do Commerce (ADR-012). Senha = COMMERCE_DB_PASSWORD do .env da raiz ---
DB_CONNECTION=commerce
DB_DRIVER=pgsql
DB_HOST=commerce-db
DB_PORT=5432
DB_DATABASE=commerce
DB_USERNAME=commerce_app
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Identity (ADR-001) ---
# URL interna da API do Identity (dados de faturamento via GET /api/v1/me).
IDENTITY_URL=http://web
# Dev: 10 s (o bind mount do Windows deixa a 1ª chamada lenta). Produção: 5 s.
IDENTITY_TIMEOUT=10
# Chave PÚBLICA do Identity (nunca a privada). Copie o valor de JWT_PUBLIC_KEY do .env da raiz
# ou rode na raiz: docker compose exec app php artisan jwt:keys --show-public
IDENTITY_JWT_PUBLIC_KEY=

# --- Pacotes (D2): preços em centavos (créditos: básico 10, médio 25, premium 50) ---
PACKAGE_BASICO_PRICE_CENTS=3000
PACKAGE_MEDIO_PRICE_CENTS=6500
PACKAGE_PREMIUM_PRICE_CENTS=12000

# --- Token para chamadas de outros serviços (Evidence) em /internal/* ---
# Gere com: openssl rand -hex 32
COMMERCE_SERVICE_TOKEN=

# --- Simulador de pagamento (tela T06). NUNCA ligar em produção real ---
PAYMENTS_SIMULATOR_ENABLED=true
# Assinatura HMAC do webhook simulado. Gere com: openssl rand -hex 32
PAYMENTS_SIMULATOR_WEBHOOK_SECRET=

# --- Mercado Pago (Checkout Pro: cartão, saldo e PIX na página do MP) — ADR-006 ---
# Painel: https://www.mercadopago.com.br/developers/panel/app -> sua aplicação.
# Use as credenciais de TESTE. Preencha AQUI (nunca no chat nem no Git).
# A forma de pagamento "mercadopago" só fica disponível com token, segredo e URL preenchidos.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# "Suas integrações -> Webhooks -> Assinatura secreta"
MERCADOPAGO_WEBHOOK_SECRET=
# URL PÚBLICA (https) que chega nesta API, ex.: https://abc123.ngrok-free.app/api/v1/webhooks/mercadopago
MERCADOPAGO_NOTIFICATION_URL=
# Página do front para onde o comprador volta depois de pagar (opcional)
MERCADOPAGO_BACK_URL=http://localhost:5173/pagamento/retorno
# PIX com QR Code mostrado pelo próprio Veridit (usa as credenciais acima; a conta MP precisa de chave PIX)
MERCADOPAGO_PIX_ENABLED=true
# Validade do QR Code em minutos (mínimo 30, exigência do Mercado Pago)
MERCADOPAGO_PIX_EXPIRATION_MINUTES=30

# --- CORS: origens do front-end ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Swagger: gera a documentação a cada acesso (dev). Produção: false + l5-swagger:generate no build ---
L5_SWAGGER_GENERATE_ALWAYS=true
