# Veridit Commerce Service — modelo da PRODUÇÃO LOCAL
# O arquivo real (commerce/.env.production) NUNCA vai para o Git: fica na pasta de deploy
# (producao-app/commerce/) e é gerado por deploy/setup-production.sh.
# Valores "gerar-*" e "copiar-*" são preenchidos pelo script de setup.
# Comentários sempre em linha própria (o env_file do Docker Compose não aceita comentário no fim da linha).

APP_NAME="Veridit Commerce"
APP_ENV=production
APP_KEY=gerar-app-key
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

# Logs no stdout/stderr: docker compose -p veridit_prod -f docker-compose.prod.yml logs -f commerce-app
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Banco PRÓPRIO do Commerce (ADR-012). Senha = COMMERCE_DB_PASSWORD do .env.production da raiz
DB_CONNECTION=commerce
DB_DRIVER=pgsql
DB_HOST=commerce-db
DB_PORT=5432
DB_DATABASE=commerce
DB_USERNAME=commerce_app
DB_PASSWORD=copiar-commerce-db-password

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Identity da produção (rede interna) e sua chave PÚBLICA (= JWT_PUBLIC_KEY do .env.production da raiz)
IDENTITY_URL=http://web
IDENTITY_TIMEOUT=5
IDENTITY_JWT_PUBLIC_KEY=copiar-identity-public-key

# Pacotes (D2): preços em centavos
PACKAGE_BASICO_PRICE_CENTS=3000
PACKAGE_MEDIO_PRICE_CENTS=6500
PACKAGE_PREMIUM_PRICE_CENTS=12000

# Token para o Evidence chamar /internal/*
COMMERCE_SERVICE_TOKEN=gerar-token

# Simulador de pagamento (T06). Desligado por padrão: ligue (true) só para demonstração local,
# NUNCA em produção real.
PAYMENTS_SIMULATOR_ENABLED=false
PAYMENTS_SIMULATOR_WEBHOOK_SECRET=gerar-token

# Mercado Pago (credenciais da conta; só fica disponível com os três primeiros preenchidos)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_BACK_URL=http://localhost:3000/pagamento/retorno
# PIX com QR Code mostrado pelo próprio Veridit (usa as credenciais acima; a conta MP precisa de chave PIX)
MERCADOPAGO_PIX_ENABLED=true
# Validade do QR Code em minutos (mínimo 30, exigência do Mercado Pago)
MERCADOPAGO_PIX_EXPIRATION_MINUTES=30

# Swagger gerado no build da imagem
L5_SWAGGER_GENERATE_ALWAYS=false

# Front-end da outra equipe
CORS_ALLOWED_ORIGINS=http://localhost:3000
