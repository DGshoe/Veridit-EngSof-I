# Veridit Identity Service — modelo da PRODUÇÃO LOCAL
# O arquivo real (.env.production) NUNCA vai para o Git: fica na pasta de deploy
# (producao-app/) e é gerado por deploy/setup-production.sh com segredos aleatórios.
# Valores "gerar-*" são substituídos pelo script de setup.
# Comentários sempre em linha própria (o env_file do Docker Compose não aceita comentário no fim da linha).

APP_NAME="Veridit Identity"
APP_ENV=production
APP_KEY=gerar-app-key
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs no stdout/stderr do container: docker compose ... logs -f app
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Banco do Identity Service (única conexão da aplicação — ADR-012)
DB_CONNECTION=identity
DB_DRIVER=pgsql
DB_HOST=identity-db
DB_PORT=5432
DB_DATABASE=identity
DB_USERNAME=identity_app
# Igual a IDENTITY_DB_PASSWORD do .env.production da raiz (o setup-production.sh preenche)
DB_PASSWORD=gerar-senha


# Administrador inicial (criado no primeiro deploy pelo AdminSeeder)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@veridit.local
ADMIN_PASSWORD=gerar-senha-admin
ADMIN_CPF=gerar-cpf

# JWT RS256 (par de chaves DIFERENTE do dev, gerado pelo setup-production.sh).
# Só a chave PÚBLICA pode ser entregue aos outros serviços. Access token 15 min; refresh 7 dias.
JWT_ALGO=RS256
JWT_PRIVATE_KEY=gerar-jwt-private-key
JWT_PUBLIC_KEY=gerar-jwt-public-key
JWT_TTL=15
JWT_REFRESH_TTL=10080
JWT_BLACKLIST_ENABLED=true

# Front-end da outra equipe: link de redefinição de senha e CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail: Mailpit de produção (interface em http://localhost:8026)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@veridit.local"
MAIL_FROM_NAME="Veridit Identity"

# Swagger: gerado no build da imagem; nunca em tempo de requisição
L5_SWAGGER_GENERATE_ALWAYS=false
