# Veridit — orquestração da PRODUÇÃO LOCAL (docker-compose.prod.yml).
# O arquivo real (.env.production) fica na pasta de deploy (producao-app/), NUNCA no Git,
# e é gerado por deploy/setup-production.sh com senhas aleatórias.
# Cada serviço recebe apenas a SUA senha:
#   backend/identity/.env.production  DB_PASSWORD = IDENTITY_DB_PASSWORD
#   backend/commerce/.env.production  DB_PASSWORD = COMMERCE_DB_PASSWORD

POSTGRES_ADMIN_PASSWORD=gerar-senha
IDENTITY_DB_PASSWORD=gerar-senha
COMMERCE_DB_PASSWORD=gerar-senha
EVIDENCE_DB_PASSWORD=gerar-senha
NOTIFICATION_DB_PASSWORD=gerar-senha
